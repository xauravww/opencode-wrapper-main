# ==========================================
# OPENCODE WRAPPER - ENVIRONMENT CONFIGURATION
# ==========================================

# ── Core Infrastructure ──
PORT=3010
DEV_MODE=false
ALLOWED_ORIGINS=http://localhost:3011
MONGODB_URI=mongodb://localhost:27017/opencode_wrapper
REDIS_URL=redis://localhost:6379

# ── Admin & Security ──
ADMIN_USER=admin
ADMIN_PASS=changeme
JWT_SECRET=generate_a_secure_secret_for_production

# ── Rate Limiting (Active when DEV_MODE=false) ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Fallback & Core AI Provider (OpenCode) ──
DEFAULT_MODEL=big-pickle
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_API_KEY=your_zen_api_key_here

# ── Premium LLM Providers (Comma-separated keys) ──
GROQ_API_KEYS=
NVIDIA_API_KEYS=
GEMINI_API_KEYS=
CEREBRAS_API_KEYS=
AITOOLS_API_KEYS=
TOGETHER_API_KEYS=
FIREWORKS_API_KEYS=
ANTHROPIC_API_KEYS=
DEEPSEEK_API_KEYS=
MISTRAL_API_KEYS=
COHERE_API_KEYS=
OPENROUTER_API_KEYS=

# ── Routing & Performance Tuning ──
PROVIDER_PRIORITY=cerebras,groq,nvidia,gemini,openrouter,together,fireworks,anthropic,deepseek,mistral,cohere,opencode,aitools
SPEED_WEIGHT_MULTIPLIER=0.8
ERROR_PENALTY_MULTIPLIER=2.0
HEALTH_CHECK_INTERVAL=30000
STATS_UPDATE_INTERVAL=5000
MAX_STATS_HISTORY=1000
PROVIDER_STATS_FILE=./provider_stats.json

# ── Email & Notifications ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
OWNER_MAIL=

# ── System Maintenance ──
PING_URLS=
