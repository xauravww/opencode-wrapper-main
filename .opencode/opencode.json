{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "numes": {
      "name": "Numes Free",
      "env": ["NUMES_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.numes.ai/api/v1",
        "headerTimeout": 600000,
        "chunkTimeout": false
      },
      "models": {
        "deepseek-v4.1-flash": {
          "modelID": "deepseek/deepseek-v4.1-flash:free",
          "name": "DeepSeek V4.1 Flash (free)",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "deepseek-v4.1-flash-uncensored-fp8": {
          "modelID": "dealignai/deepseek-v4.1-flash-uncensored-fp8:free",
